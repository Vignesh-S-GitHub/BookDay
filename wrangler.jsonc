{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookday",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/fragments/*"]
  },
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
